#!/usr/bin/env bash
# Copia una foto/archivo recibido por Telegram a comprobantes/AAAA/MM/ y devuelve la ruta nueva.
# Solo acepta archivos del inbox del plugin de Telegram.
set -euo pipefail
BASE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
INBOX="$(readlink -f "${TELEGRAM_STATE_DIR:-$HOME/.claude/channels/telegram}/inbox")"
SRC="$(readlink -f "${1:?Uso: guardar-comprobante <ruta_en_inbox>}")"
case "$SRC" in "$INBOX"/*) ;; *) echo "Error: solo se aceptan archivos de $INBOX" >&2; exit 1;; esac
DEST_DIR="$BASE/comprobantes/$(date +%Y/%m)"
mkdir -p "$DEST_DIR"
DEST="$DEST_DIR/$(date +%Y%m%d-%H%M%S)-$(basename "$SRC")"
cp "$SRC" "$DEST"
echo "$DEST"
